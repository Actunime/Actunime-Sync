{
  "name": "actunime-sync",
  "version": "1.0.0-beta.7",
  "description": "Extension de synchronisation et suivi des animes & mangas avec Actunime",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Actunime/Actunime-Sync#readme",
  "bugs": {
    "url": "https://github.com/Actunime/Actunime-Sync/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actunime/Actunime-Sync.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@crxjs/vite-plugin": "^2.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/chrome": "^0.0.284",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22"
  }
}
